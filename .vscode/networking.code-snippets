    "setsockopt SO_REUSEADDR": {
        "scope": "cpp,c",
        "prefix": ["sso", "setsockopt", "reuseaddr"],
        "body": [
            "int yes{1};",
            "if (setsockopt(${1:listener}, ${2|SOL_SOCKET,IPPROTO_TCP|}, ${3|SO_REUSEADDR,SO_REUSEPORT,SO_KEEPALIVE,TCP_NODELAY|}, &yes, sizeof(yes)) == -1) {",
            "    std::cerr << \"setsockopt failed: \" << std::strerror(errno) << '\\n';",
            "    return 1;",
            "}",
            "$0"
