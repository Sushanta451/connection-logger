            "inet_ntop(AF_INET, &${2:client}.sin_addr, $1, sizeof($1));",
            "std::cout << $1 << ':' << ntohs($2.sin_port) << '\\n';",
            "$0"
        ],
        "description": "Turn a binary address into a readable string like 127.0.0.1"
