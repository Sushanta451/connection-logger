    "accept() one client": {
        "scope": "cpp,c",
        "prefix": ["acc", "accept"],
        "body": [
            "sockaddr_in ${1:client}{};",
            "socklen_t ${1}_len{sizeof($1)};",
            "int ${2:conn}{accept(${3:listener}, reinterpret_cast<sockaddr*>(&$1), &${1}_len)};",
            "if ($2 == -1) {",
            "    std::cerr << \"accept failed: \" << std::strerror(errno) << '\\n';",
            "    return 1;",
            "}",
            "$0"
        ],
        "description": "Block until a client connects, returning a new fd for that client"
    },

    "accept loop": {
        "scope": "cpp,c",
        "prefix": ["alp", "acceptloop"],
        "body": [
            "while (true) {",
            "    sockaddr_in client{};",
            "    socklen_t client_len{sizeof(client)};",
            "    int conn{accept(${1:listener}, reinterpret_cast<sockaddr*>(&client), &client_len)};",
            "    if (conn == -1) {",
            "        std::cerr << \"accept failed: \" << std::strerror(errno) << '\\n';",
            "        continue;",
            "    }",
            "",
            "    char ip[INET_ADDRSTRLEN];",
            "    inet_ntop(AF_INET, &client.sin_addr, ip, sizeof(ip));",
            "    std::cout << \"connection from \" << ip << ':' << ntohs(client.sin_port) << '\\n';",
            "",
            "    $0",
            "",
            "    close(conn);",
            "}"
        ],
        "description": "Serve clients forever, one at a time"
    },

    "recv() + the three cases": {
        "scope": "cpp,c",
        "prefix": ["rcv", "recv"],
        "body": [
            "char ${1:buf}[${2:1024}];",
            "ssize_t ${3:n}{recv(${4:conn}, $1, sizeof($1), 0)};",
            "if ($3 == -1) {",
            "    std::cerr << \"recv failed: \" << std::strerror(errno) << '\\n';",
            "} else if ($3 == 0) {",
            "    std::cout << \"client closed the connection\\n\";",
            "} else {",
            "    $0",
            "}"
        ],
        "description": "Read from a client. -1 is an error, 0 means they hung up, >0 is byte count"
    },

    "send() all bytes": {
        "scope": "cpp,c",
        "prefix": ["snd", "sendall", "send"],
        "body": [
            "// send() may send fewer bytes than asked, so loop until it's all out",
            "size_t total{0};",
            "while (total < ${1:len}) {",
            "    ssize_t sent{send(${2:conn}, ${3:buf} + total, $1 - total, 0)};",
            "    if (sent == -1) {",
            "        std::cerr << \"send failed: \" << std::strerror(errno) << '\\n';",
            "        break;",
            "    }",
            "    total += static_cast<size_t>(sent);",
            "}",
            "$0"
        ],
        "description": "Send a whole buffer, handling partial sends"
    },

