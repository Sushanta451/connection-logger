        "scope": "cpp,c",
        "prefix": ["sock", "socket"],
        "body": [
            "int ${1:listener}{socket(${2|AF_INET,AF_INET6,AF_UNSPEC|}, ${3|SOCK_STREAM,SOCK_DGRAM|}, 0)};",
            "if ($1 == -1) {",
            "    std::cerr << \"socket failed: \" << std::strerror(errno) << '\\n';",
            "    return 1;",
            "}",
