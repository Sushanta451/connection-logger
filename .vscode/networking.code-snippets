    "Full TCP server skeleton": {
        "scope": "cpp,c",
        "prefix": ["tcpserver", "srv"],
        "body": [
            "#include <sys/socket.h>",
            "#include <netinet/in.h>",
            "#include <arpa/inet.h>",
            "#include <unistd.h>",
            "#include <cerrno>",
            "#include <cstring>",
            "#include <iostream>",
            "",
            "int main() {",
            "    // 1. create the socket",
            "    int listener{socket(AF_INET, SOCK_STREAM, 0)};",
            "    if (listener == -1) {",
            "        std::cerr << \"socket failed: \" << std::strerror(errno) << '\\n';",
            "        return 1;",
            "    }",
            "",
            "    // 2. let the port be reused immediately after a restart",
            "    int yes{1};",
            "    if (setsockopt(listener, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes)) == -1) {",
            "        std::cerr << \"setsockopt failed: \" << std::strerror(errno) << '\\n';",
            "        return 1;",
            "    }",
            "",
            "    // 3. pick the address and port",
            "    sockaddr_in addr{};",
            "    addr.sin_family = AF_INET;",
            "    addr.sin_port = htons(${1:8080});",
            "    addr.sin_addr.s_addr = htonl(INADDR_ANY);",
            "",
            "    // 4. claim it",
            "    if (bind(listener, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == -1) {",
            "        std::cerr << \"bind failed: \" << std::strerror(errno) << '\\n';",
            "        close(listener);",
            "        return 1;",
            "    }",
            "",
            "    // 5. start queueing incoming connections",
            "    if (listen(listener, SOMAXCONN) == -1) {",
            "        std::cerr << \"listen failed: \" << std::strerror(errno) << '\\n';",
            "        close(listener);",
            "        return 1;",
            "    }",
            "    std::cout << \"listening on port $1\\n\";",
            "",
            "    // 6. serve clients",
            "    while (true) {",
            "        sockaddr_in client{};",
            "        socklen_t client_len{sizeof(client)};",
            "        int conn{accept(listener, reinterpret_cast<sockaddr*>(&client), &client_len)};",
            "        if (conn == -1) {",
            "            std::cerr << \"accept failed: \" << std::strerror(errno) << '\\n';",
            "            continue;",
            "        }",
            "",
            "        char ip[INET_ADDRSTRLEN];",
            "        inet_ntop(AF_INET, &client.sin_addr, ip, sizeof(ip));",
            "        std::cout << \"connection from \" << ip << ':' << ntohs(client.sin_port) << '\\n';",
            "",
            "        $0",
            "",
            "        close(conn);",
            "    }",
            "",
            "    close(listener);",
            "    return 0;",
            "}"
        ],
        "description": "A complete, working single-client-at-a-time TCP server"
    }
}
