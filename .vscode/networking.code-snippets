            "$1.sin_family = AF_INET;",
            "$1.sin_port = htons(${2:8080});      // host byte order -> network byte order",
            "$1.sin_addr.s_addr = htonl(${3|INADDR_ANY,INADDR_LOOPBACK|});",
            "$0"
        ],
        "description": "Fill in an IPv4 address struct"
