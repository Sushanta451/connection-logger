    },

    "listen() + error check": {
        "scope": "cpp,c",
        "prefix": ["lsn", "listen"],
        "body": [
            "if (listen(${1:listener}, ${2:SOMAXCONN}) == -1) {",
            "    std::cerr << \"listen failed: \" << std::strerror(errno) << '\\n';",
            "    close($1);",
            "    return 1;",
            "}",
            "std::cout << \"listening on port ${3:8080}\\n\";",
            "$0"
        ],
        "description": "Mark the socket as passive (ready to accept)"
