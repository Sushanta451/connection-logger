    "getaddrinfo block": {
        "scope": "cpp,c",
        "prefix": ["gai", "getaddrinfo"],
        "body": [
            "addrinfo hints{};",
            "hints.ai_family = ${1|AF_UNSPEC,AF_INET,AF_INET6|};  // AF_UNSPEC = IPv4 or IPv6",
            "hints.ai_socktype = SOCK_STREAM;",
            "hints.ai_flags = AI_PASSIVE;                // fill in my IP for me",
            "",
            "addrinfo* res{};",
            "int rv{getaddrinfo(${2:nullptr}, \"${3:8080}\", &hints, &res)};",
            "if (rv != 0) {",
            "    std::cerr << \"getaddrinfo: \" << gai_strerror(rv) << '\\n';  // not errno!",
            "    return 1;",
            "}",
            "",
            "$0",
            "",
            "freeaddrinfo(res);"
        ],
        "description": "Resolve a host/port without hardcoding sockaddr_in (works for IPv4 and IPv6)"
    },

